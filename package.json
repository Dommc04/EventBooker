{
  "name": "mixer-eventbooker",
  "version": "1.0.0",
  "description": "Event Booking Desktop Application",
  "author": "Your Name",
  "private": true,
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "cd Server && node index.js",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.1.6"
  },
  "build": {
    "appId": "com.mixer.eventbooker",
    "productName": "Mixer EventBooker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron-main.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}